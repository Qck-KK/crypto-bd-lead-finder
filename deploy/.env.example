# deploy/.env: infrastructure secrets, read by docker compose only. Never commit it.
# Generate the first three on the server: openssl rand -hex 32
# Never change ENCRYPTION_KEY after the first start (it encrypts the wallet secrets).
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
ADMIN_KEY=

# Blockfrost, Cardano Preprod project (https://blockfrost.io)
BLOCKFROST_API_KEY_PREPROD=
