# deploy/agent.env: passed to the agent container only. Never commit it.
# NETWORK, PAYMENT_SERVICE_URL, AGENT_DATABASE_URL and PORT are set in docker-compose.yml.

TREG_TOKEN=
TREG_MAX_COST_USD=0.15
TREG_JOB_BUDGET_USD=0.15
MIN_LEADS_BEFORE_PAID=5
MIN_LEAD_SCORE=35
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45
MAX_PEOPLE=10

# From the Payment Service after seeding (README "Deploy on a server")
PAYMENT_API_KEY=
SELLER_VKEY=
# After registration
AGENT_IDENTIFIER=
AGENT_PUBLIC_URL=

PRICE_MARKUP=3
PRICE_TUSDM=

# Feedback links in reports (openssl rand -hex 32) and the admin token for /feedback/summary,
# /admin/stats and /metrics (header x-admin-token)
FEEDBACK_SECRET=
FEEDBACK_ADMIN_TOKEN=

# Circuit breaker: treg spend per UTC day, shared by every agent on the database (router + enrichment)
DAILY_SPEND_CAP_USD=1.0
# Hard limit for one run of a job (seconds). Its spend hold counts until the end of the UTC day containing
# start + this limit + 10 min, so a run can never spend after its hold stops counting.
ATTEMPT_TIMEOUT_S=1800
# Count treg refusals its docs call free (402 route_max_cost, 409, 422, ...) as $0. Keep false until treg
# confirms; false counts them at their max cost.
TREG_TRUST_UNCHARGED_REFUSALS=false
# Operator switch: refuse new jobs (/availability unavailable, /start_job 503), e.g. before a rollback.
PAUSE_NEW_JOBS=false
# /start_job limits before a payment request is created, per agent; -1 = no limit. Behind a proxy or a
# marketplace every request may share one address: then set the per-client limit equal to the total, or name
# the header that carries the real client (its first entry is used).
START_JOB_PER_CLIENT_PER_HOUR=10
START_JOB_PER_HOUR=30
MAX_AWAITING_PAYMENT=30
RATE_LIMIT_CLIENT_HEADER=
# text or json
LOG_FORMAT=text

# Pro only (agent-pro.env): enrichment spend per job in USD. 0 disables enrichment. On Preprod buyers pay
# with test tokens while enrichment costs real treg balance, so keep 0 until you accept that.
# While it is 0 (or below one match, ~$0.026) the Pro agent reports unavailable and refuses new jobs,
# because it would sell the standard results at the Pro price. PRO_ALLOW_WITHOUT_ENRICHMENT=true
# keeps selling it anyway (test deployments only); preflight still fails.
ENRICH_BUDGET_USD=0
PRO_ALLOW_WITHOUT_ENRICHMENT=false
