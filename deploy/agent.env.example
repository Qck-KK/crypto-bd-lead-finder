# deploy/agent.env: passed to the agent container only. Never commit it.
# NETWORK, PAYMENT_SERVICE_URL, AGENT_DATABASE_URL and PORT are set in docker-compose.yml.

TREG_TOKEN=
TREG_MAX_COST_USD=0.15
TREG_JOB_BUDGET_USD=0.15
MIN_LEADS_BEFORE_PAID=5
MIN_LEAD_SCORE=35
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_PEOPLE=10

# From the Payment Service after seeding (README "Deploy on a server")
PAYMENT_API_KEY=
SELLER_VKEY=
# After registration
AGENT_IDENTIFIER=
AGENT_PUBLIC_URL=

PRICE_MARKUP=3
PRICE_TUSDM=

# Feedback links in reports (openssl rand -hex 32) and the admin token for /feedback/summary,
# /admin/stats and /metrics (header x-admin-token)
FEEDBACK_SECRET=
FEEDBACK_ADMIN_TOKEN=

# Circuit breaker: paid provider spend per UTC day for this agent (router + enrichment)
DAILY_SPEND_CAP_USD=1.0
# text or json
LOG_FORMAT=text

# Pro only (agent-pro.env): enrichment spend per job in USD. 0 disables enrichment. On Preprod buyers pay
# with test tokens while enrichment costs real treg balance, so keep 0 until you accept that.
ENRICH_BUDGET_USD=0
