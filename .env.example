# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Masumi (from your Payment Service admin, http://localhost:3001/admin) ---
NETWORK=Preprod
PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
PAYMENT_API_KEY=
SELLER_VKEY=
# Filled in after the agent is registered (AI Agents table in the admin).
AGENT_IDENTIFIER=

# --- treg people search (https://treg.to/app) ---
TREG_TOKEN=
# Hard ceiling per search call in USD (treg header X-Treg-Route-Max-Cost).
TREG_MAX_COST_USD=0.15
# Router: total treg spend per job; paid providers are only used if the free ones found fewer
# than MIN_LEADS_BEFORE_PAID leads; leads below MIN_LEAD_SCORE (0-100) are not delivered.
TREG_JOB_BUDGET_USD=0.15
MIN_LEADS_BEFORE_PAID=5
MIN_LEAD_SCORE=35

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Results (hard-capped at 10 in code) ---
MAX_PEOPLE=10

# --- Pricing (see app/pricing.py; printed by scripts/registration_values.py) ---
PRICE_MARKUP=3
# Leave empty to use cost x markup. Example: PRICE_TUSDM=0.30
PRICE_TUSDM=
COST_TREG_PER_ROW_USD=0.0089
COST_LLM_PER_JOB_USD=0

# --- Job persistence (optional locally; set by deploy/docker-compose.yml on a server) ---
# AGENT_DATABASE_URL=postgresql://user:pass@localhost:5432/agent_jobs

# --- Server ---
HOST=0.0.0.0
PORT=8080
# Public https URL Sokosumi and the Payment Service use to reach this agent.
AGENT_PUBLIC_URL=
